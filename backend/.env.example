PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lifeos?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (scheme + host, no trailing slash).
# Example for a Vercel project, covering both the production URL and every
# preview deployment:
#   CLIENT_ORIGIN=https://life-track.vercel.app,*.vercel.app
CLIENT_ORIGIN=http://localhost:5173
